        <ml id="ID17559">fun expTime (mean : int) = 
let 
val realMean = Real.fromInt mean
val rv = exponential ((1.0/realMean))
in
floor (rv+0.5)
end;
fun intTime() = IntInf.toInt (time());
fun newJob() = {jobType = JobType.ran(),
AT = intTime()}
          <layout>fun expTime (mean : int) = 
let 
val realMean = Real.fromInt mean
val rv = exponential ((1.0/realMean))
in
floor (rv+0.5)
end;
fun intTime() = IntInf.toInt (time());
fun newJob() = {jobType = JobType.ran(),
AT = intTime()}</layout>
        </ml>
